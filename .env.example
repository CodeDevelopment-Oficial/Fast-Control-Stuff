# ============ BASE DE DATOS (solo FastAPI la consume) ============
DATABASE_URL=mysql+pymysql://fcs_user:fcs_pass@127.0.0.1:3306/fcs_inventario?charset=utf8mb4

# ============ FASTAPI CORE ============
SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============ BLOQUEO POR INTENTOS FALLIDOS ============
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ============ SMTP (recuperación de contraseña) ============
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_USER=noreply@tudominio.com
SMTP_PASSWORD=cambia-esto
SMTP_FROM="Fast Control Stuff <noreply@tudominio.com>"
SMTP_TLS=true
PASSWORD_RESET_URL_TTL_HOURS=1

# ============ FLASK CLIENT ============
FLASK_SECRET_KEY=cambia-esto-tambien
# URL interna hacia FastAPI (en prod: subdominio interno detrás de IIS)
FASTAPI_BASE_URL=http://127.0.0.1:8000/api/v1
# Cookie de sesión Flask persistente si "Recordar sesión" está activo (horas)
REMEMBER_COOKIE_MAX_AGE_HOURS=720
